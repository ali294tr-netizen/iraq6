  flex:0 0 46%;
  width:46%!important;
  height:34px!important;
  margin:4px 0 0 0!important;
  padding:0!important;
  top:auto!important;
  left:auto!important;
  display:flex!important;
  align-items:center;
  justify-content:center;
  font-family:Cairo,sans-serif!important;
  font-size:14px;
  font-weight:800;
  color:#1b1309!important;
  border:1px solid rgba(245,220,150,.8)!important;
  border-radius:20px!important;
  background:linear-gradient(180deg,#ecd084 0,#c9a24f 50%,#8f6a22 100%)!important;
  box-shadow:inset 0 1px 0 rgba(255,245,200,.5),0 2px 7px rgba(0,0,0,.45)!important;
  text-shadow:0 1px 0 rgba(255,235,170,.5);
}

/* خانة "دخول مخفي" */
#tabs-content #login-form__hidden-checkbox{
  position:static!important;
  top:0!important;
  margin:4px 0 0
}
