}
/* بطاقات المتصلين: فاتحة بستروك ذهبي */
#online_users > div,
#online_users > li,
#online_users .uzer{
  background:linear-gradient(180deg,#fffaf0 0,#f6ecd2 100%)!important;
  border:1px solid rgba(214,176,90,.5)!important;
  border-right:4px solid #c9a24f!important;
  border-left:4px solid #c9a24f!important;
  border-radius:6px!important;
  box-shadow:inset 0 1px 0 rgba(255,255,255,.8),0 1px 4px rgba(80,55,10,.18)!important;
  color:#3a2b14!important;
  margin-bottom:6px;
}

/* النصوص الصغيرة داخل البطاقة */
#online_users > div *,
#online_users > li *,
#online_users .uzer *{
  color:#5a4521;
}
/* النجوم: لون ثابت لا يتأثر بلون البطاقة */
#online_users .chat_pane__user_item--stars,
#online_users .chat_pane__user_item--stars *{
  color:#f2b01e!important;
}
/* لمعة زجاجية تعبر على النجوم وتتكرر */
#online_users .chat_pane__user_item--stars{
  position:relative;
  display:inline-block;
  overflow:hidden;
  vertical-align:middle;
}

#online_users .chat_pane__user_item--stars::after{
  content:"";
  position:absolute;
  top:-20%;
  left:-60%;
  width:40%;
  height:140%;
  pointer-events:none;
  background:linear-gradient(
    100deg,
    rgba(255,255,255,0) 0%,
    rgba(255,255,255,.85) 50%,
    rgba(255,255,255,0) 100%
  );
  transform:skewX(-20deg);
  animation:starShine 2.8s ease-in-out infinite;
}

@keyframes starShine{
  0%   { left:-60%; }
  55%  { left:130%; }
  100% { left:130%; }
}
