/* الشريط */
html body .users-count-label{
  position:relative;
  width:98%;
  height:27px;
  padding:0!important;
  overflow:hidden;
  border:1px solid rgba(214,176,90,.5)!important;
  border-radius:0 8px 8px 0;
  background:linear-gradient(90deg,#0d0905 0,#2a1f12 36%,#5c4420 72%,#b8923f 100%)!important;
  box-shadow:inset 0 1px 0 rgba(255,235,170,.12),0 2px 5px rgba(0,0,0,.4);
}

/* البيل الداكن الذي فيه النص */
html body .users-count-label p{
  position:relative;
  top:0!important;
  left:0!important;
  width:38%!important;
  height:100%!important;
  margin:0!important;
  padding:0 6px!important;
  display:flex;
  align-items:center;
  justify-content:center;
  gap:5px;
  font-size:12px!important;
  font-weight:700;
  line-height:1;
  color:#f6e7c1!important;
  white-space:nowrap;
  border:0!important;
  border-right:3px solid #e8c776!important;
  border-radius:0!important;
  background:linear-gradient(180deg,#1a130b 0,#0a0705 100%)!important;
  box-shadow:inset 0 1px 0 rgba(255,235,170,.08);
}

/* الأيقونة والعدد */
html body .users-count-label p .fa,
html body .users-count-label p .count{
  color:#f0d48a!important;
  font-size:12px!important;
}
/* البيل */
html body #app .users-count-label p.label-count{
  position:relative;
  top:0!important;
  left:0!important;
  width:auto!important;
  min-width:150px;
  max-width:70%;
  height:100%!important;
  margin:0!important;
  padding:0 14px!important;
  display:flex!important;
  direction:ltr;                 /* الأيقونة والعدد يسار، النص يمين */
  align-items:center;
  justify-content:center;
  gap:8px;
  font-family:Fanni,'El Messiri',sans-serif!important;
  font-size:15px!important;
  font-weight:700;
  line-height:1;
  color:#f6e7c1!important;
  white-space:nowrap;
  background:linear-gradient(180deg,#1a130b 0,#080604 100%)!important;
  border:2px solid #d6b05a!important;
  border-radius:16px!important;
  box-shadow:inset 0 1px 0 rgba(255,235,170,.15),0 2px 5px rgba(0,0,0,.5);
}

/* الأيقونة + العدد */
html body #app .users-count-label p.label-count .fa{
  display:inline-flex!important;
  align-items:center;
  gap:6px;
  margin:0!important;
  padding:0!important;
  background:none!important;
  border:0!important;
  color:#f0d48a!important;
  font-size:15px!important;
}

/* أيقونة شخص واحد */
html body #app .users-count-label p.label-count .fa::before{
  content:"\f007"!important;
  font-family:FontAwesome!important;
  font-size:21px!important;
  position:static!important;
  margin:0!important;
}

/* رقم العدد */
html body #app .users-count-label p.label-count .count{
  font-family:Arial,Helvetica,sans-serif!important;
  font-size:17px!important;
  font-weight:700;
  color:#f0d48a!important;
}
html body #connection_container,
html body #connection_container #connection-state-on,
html body #connection_container #connection-state-off{
  display:none!important;
}
/* البيل بحجم المحتوى */
html body #app .users-count-label p.label-count{
  flex:0 0 auto!important;
  width:fit-content!important;
  min-width:0!important;
  max-width:none!important;
  height:60px!important;
  margin:0 0 0 2px!important;
  padding:0 9px!important;
  display:inline-flex!important;
  direction:ltr!important;
  align-items:center;
  justify-content:center;
  gap:6px;
  overflow:visible!important;
  white-space:nowrap!important;
  font-size:10px!important;
  color:#f6e7c1!important;
}

/* النص بعد الأيقونة والعدد */
html body #app .users-count-label p.label-count::after{
  content:"المتواجدون الان";
  display:inline-block;
  direction:rtl;
  font-family:Fanni,'El Messiri',sans-serif;
  font-size:13px;
  font-weight:700;
  color:#f6e7c1;
}
html body #app .users-count-label p.label-count{
  display:inline-flex!important;
  flex-direction:row!important;
  flex-wrap:nowrap!important;
  align-items:center!important;
  justify-content:center!important;
  direction:ltr!important;
  gap:6px!important;
  height:26px!important;
  line-height:1!important;
  white-space:nowrap!important;
  overflow:visible!important;
}

/* الأيقونة + الرقم بصف واحد */
html body #app .users-count-label p.label-count .fa{
  display:inline-flex!important;
  flex-direction:row!important;
  flex-wrap:nowrap!important;
  align-items:center!important;
  gap:4px!important;
  float:none!important;
  width:auto!important;
  height:auto!important;
  margin:0!important;
  padding:0!important;
  line-height:1!important;
}

html body #app .users-count-label p.label-count .fa::before{
  position:static!important;
  margin:0!important;
  float:none!important;
}

html body #app .users-count-label p.label-count .count{
  display:inline!important;
  float:none!important;
  margin:0!important;
  padding:0!important;
  line-height:1!important;
}

/* النص بنفس الصف */
html body #app .users-count-label p.label-count::after{
  display:inline-block!important;
  line-height:1!important;
  white-space:nowrap!important;
}
/* ترتيب العناصر بصف واحد: أيقونة ← رقم ← نص */
html body #app .users-count-label p.label-count{
  display:inline-flex!important;
  flex-direction:row!important;
  align-items:center!important;
  justify-content:center!important;
  direction:ltr!important;
  gap:8px!important;
  width:fit-content!important;
  padding:0 14px!important;
}

/* إلغاء أي تثبيت مطلق من كود الموقع */
html body #app .users-count-label p.label-count .fa,
html body #app .users-count-label p.label-count .count,
html body #app .users-count-label p.label-count .fa::before{
  position:static!important;
  top:auto!important;
  left:auto!important;
  right:auto!important;
  bottom:auto!important;
  transform:none!important;
  float:none!important;
  margin:0!important;
  width:auto!important;
  height:auto!important;
}

html body #app .users-count-label p.label-count .fa{ order:1; display:inline-flex!important; align-items:center!important; gap:6px!important; }
html body #app .users-count-label p.label-count .count{ order:2; display:inline-block!important; }
html body #app .users-count-label p.label-count::after{ order:3; position:static!important; margin:0 0 0 4px!important; }
/* الحقول: ستروك ذهبي يمين ويسار */
