#login-header {
  display: none !important;
}
/* حاوية التبويبات */
.react-tabs{margin-top:-1.2rem}

ul#tabs{
  border-radius:0;
  width:100%!important;
  height:102px;
  padding:0!important;
  margin-top:68px;
  position:relative;
  overflow-x:clip;
  overflow-y:visible;
  border:1px solid rgba(214,176,90,.35)!important;
  background:linear-gradient(180deg,#1e160e 0,#151009 55%,#0d0905 100%)!important;
  box-shadow:inset 0 1px 0 rgba(255,235,170,.08),0 2px 8px rgba(0,0,0,.35)!important;
}
ul#tabs::before,
ul#tabs::after{display:none!important;content:none!important;animation:none!important}

/* عنصر li */
.react-tabs__tab-list,
.react-tabs__tab{text-align:center;margin-top:-8px;background:0 0!important;border:none}

.react-tabs__tab{
  width:32.5%;
  font-size:.625rem;
  margin-left:3px;
  position:relative;
  top:13px;
  right:19px;
}

/* الزر الفعلي (الرابط a داخل li) */
.react-tabs__tab a,
.react-tabs__tab a.active{
  position:relative!important;
  z-index:5;
  top:-41px;
  margin:0 0 0 20px;
  width:99%;
  height:32px;
  padding:8px 0 0!important;
  text-align:center;
  line-height:20px;
  border-radius:4px!important;
  font-size:.7rem;
  font-weight:600;
  color:#f1deb0!important;
  border:1px solid rgba(214,176,90,.35)!important;
  background:linear-gradient(180deg,#2e2415 0,#211a10 55%,#17110a 100%)!important;
  box-shadow:inset 0 1px 0 rgba(255,235,170,.1),0 1px 3px rgba(0,0,0,.35)!important;
  text-shadow:0 1px 2px rgba(0,0,0,.6)!important;
}

/* الإطار الداخلي الرفيع */
.react-tabs__tab a::before,
.react-tabs__tab a.active::before{
  content:"";
  position:absolute;
  inset:1px;
  border-radius:9px;
  border:1px solid rgba(214,176,90,.28);
  pointer-events:none;
}

/* الزر المحدد */
.react-tabs__tab a.active{
  color:#1b1309!important;
  border-color:rgba(245,215,130,.8)!important;
  background:linear-gradient(135deg,#e8c776 0,#d2a94d 38%,#a67c2e 72%,#7a5a1f 100%)!important;
  text-shadow:0 1px 0 rgba(255,235,170,.45)!important;
}

/* خلفية محتوى التبويب */
#tabs-content{background:linear-gradient(180deg,#1b140d,#120d08)!important}
/* خلفية منطقة التبويب */
#tabs-content.tab-content{
  padding:8px 10px 10px!important;
  background:linear-gradient(180deg,#1e160e 0,#0d0905 100%)!important;
  border-radius:0 0 8px 8px;
}

/* إلغاء ارتفاع النماذج القديم */
#tabs-content #guest-form,
#tabs-content #login-form,
#tabs-content #register-form{
  height:auto!important;
  margin:0!important;
  padding:0!important;
}

/* صف واحد مرتب لكل نموذج */
#tabs-content #guest-form>div,
#tabs-content #login-form>div,
#tabs-content #register-form>div{
  display:flex!important;
  flex-wrap:wrap;
  align-items:center;
  gap:6px 0;
  direction:ltr;
}

/* الحقول */
#tabs-content #guest-form__name,
#tabs-content #login-form__name,
#tabs-content #login-form__password,
#tabs-content #register-form__name,
#tabs-content #register-form__password{
  position:static!important;
  flex:0 0 100%;
  width:100%!important;
  height:32px!important;
  margin:0!important;
  padding:0 8px!important;
  text-align:center!important;
  direction:rtl;
  font-family:Cairo,sans-serif!important;
  font-size:13px;
